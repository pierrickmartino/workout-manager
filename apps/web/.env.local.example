# Clerk — create an application at https://dashboard.clerk.com and copy these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Point Clerk at the in-app sign-in / sign-up routes (app/sign-in, app/sign-up) so
# middleware `auth.protect()` redirects a signed-out deep-linker on-domain with the
# destination preserved as ?redirect_url=…, instead of bouncing to Clerk's hosted
# Account Portal (finding #9). Omit these and protected routes redirect off-domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where the FastAPI backend is reachable from the Next.js server runtime.
# In docker compose this is the service name; locally it's localhost.
API_URL=http://localhost:8000
