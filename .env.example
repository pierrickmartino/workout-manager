# Copy to .env and fill in before `docker compose up`.
# These are consumed by docker-compose.yml and passed into the api/web services.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# The "iss" of your Clerk session tokens and its JWKS endpoint.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# --- AI generation provider (ADR-0006) ---
# AI_PROVIDER selects the generation provider per deployment. `anthropic`,
# `openai`, `google`, and `openrouter` are wired today; the other slots are
# reserved. `openrouter` reuses the OpenAI SDK pointed at
# https://openrouter.ai/api/v1. Only the *selected* provider's key is required
# at startup — the app fails fast if it's missing. Keys for unselected providers
# may be left blank.
AI_PROVIDER=anthropic

# Per-provider API keys. Set the one matching AI_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the selected provider's default model (anthropic ->
# claude-opus-4-8, openai -> gpt-5.5, google -> gemini-3.1-pro, openrouter ->
# openai/gpt-oss-120b:free). Leave blank to use the default.
AI_MODEL=

# --- Operational AI-usage monitoring: self-hosted Langfuse (ADR-0039) ---
# See docs/deployment/langfuse.md for the full setup, 90-day retention, and
# per-model pricing steps.
#
# App -> Langfuse connection. ALL THREE are required together for the app to
# record; if any is blank the factory selects the no-op recorder and nothing
# networks (this keeps the offline test suite offline). The host is a
# server-to-server URL over the compose network, so it's the langfuse-web
# service name, not localhost.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# Langfuse's own infrastructure secrets (consumed by the langfuse-* services,
# not by the app). Generate real values — never hardcode. Suggested:
#   openssl rand -hex 32     -> LANGFUSE_ENCRYPTION_KEY (must be 32-byte hex)
#   openssl rand -base64 32  -> the passwords / salt / nextauth secret
CLICKHOUSE_PASSWORD=replace-me
MINIO_PASSWORD=replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-me-64-hex-chars
LANGFUSE_NEXTAUTH_SECRET=replace-me
# LANGFUSE_PORT=3001   # host port for the operator-only Langfuse UI

# --- Host port overrides (optional) ---
# Only the host side of each mapping; containers keep their standard ports and
# talk to each other over the compose network regardless. Override any that
# clash with something already running locally, e.g. DB_PORT=5433.
# DB_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# WEB_PORT=3000